@model ourdekor.Models.Products
<h2>Состав продукции: @Model.name</h2>

<table style="width: 100%; border-collapse: collapse; margin-top: 20px;">
    <tr style="background-color: #BBD9B2;">
        <th style="padding: 10px; border: 1px solid #ccc;">Материал</th>
        <th style="padding: 10px; border: 1px solid #ccc;">Количество</th>
    </tr>
    @foreach (var pm in Model.ProductMaterials)
    {
        <tr>
            <td style="padding: 10px; border: 1px solid #ccc;">@pm.Materials?.name</td>
            <td style="padding: 10px; border: 1px solid #ccc;">@pm.count @pm.Materials?.unit</td>
        </tr>
    }
</table>
<br />
<a href="/products-list" class="btn-accent" style="text-decoration: none;">Вернуться к списку</a>