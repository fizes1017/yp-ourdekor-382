@model ourdekor.Models.Products
@{
    ViewData["Title"] = Model.id == 0 ? "Добавление" : "Редактирование";
}

<h2>@ViewData["Title"] продукции</h2>

<form action="/product/save" method="post" style="display: flex; flex-direction: column; gap: 15px; max-width: 500px;">
    <input type="hidden" asp-for="id" />

    <label>Наименование:</label>
    <input asp-for="name" required style="padding: 5px;" />

    <label>Артикул:</label>
    <input asp-for="article" required style="padding: 5px;" />

    <label>Тип продукции:</label>
    <select asp-for="ProductTypeId" style="padding: 5px;">
        @foreach (var type in ViewBag.ProductTypes)
        {
            <option value="@type.id">@type.name</option>
        }
    </select>

    <label>Минимальная стоимость для партнера:</label>
    <input asp-for="min_price" type="number" step="0.01" style="padding: 5px;" />

    <label>Ширина рулона (м):</label>
    <input asp-for="width" type="number" step="0.01" style="padding: 5px;" />

    <div style="margin-top: 10px; display: flex; gap: 10px;">
        <button type="submit" class="btn-accent">Сохранить</button>
        <a href="/products-list" style="padding: 10px; background: #eee; text-decoration: none; color: black;">Назад</a>
    </div>
</form>